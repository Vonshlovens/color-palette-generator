{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "color-palette-generator",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-20",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "color-palette-generator",
			// Omitted until the remote database exists: local dev and tests need no ID, and
			// `wrangler deploy` provisions the database and writes the ID back here.
			// "database_id": "",
			"migrations_dir": "drizzle"
		}
	]
	// The custom domain is attached at cutover (see README "Deploying to Cloudflare"):
	// "routes": [{ "pattern": "colors.vonshlovens.com", "custom_domain": true }]
}
