{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "color-palette-generator",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-20",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// One canonical address: sign-in links and session cookies are tied to BETTER_AUTH_URL.
	"routes": [{ "pattern": "colors.ericevans.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "color-palette-generator",
			"database_id": "184f7557-27bf-4bcb-b89e-1534833d1f01",
			"migrations_dir": "drizzle"
		}
	],
	// Non-secret settings. Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, and optionally
	// GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET, which turn on GitHub sign-in with the callback URL
	// https://colors.ericevans.dev/api/auth/callback/github) are set with `wrangler secret put`.
	// `.dev.vars` overrides these for local `wrangler dev`.
	"vars": {
		"BETTER_AUTH_URL": "https://colors.ericevans.dev",
		"AUTH_EMAIL_FROM": "Palette Studio <colors@mail.ericevans.dev>",
		"OWNER_EMAIL": "eric@ericevans.dev"
	}
}
