# Local development. Docker Compose overrides this default with file:/data/local.db.
TURSO_DATABASE_URL=file:local.db

# Required only for a remote libSQL/Turso URL. An empty value is treated as absent.
TURSO_AUTH_TOKEN=

# Docker Compose host binding and canonical public application URL.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
ORIGIN=http://localhost:3000

# Use forwarded headers only behind a trusted reverse proxy; see README.md.
PROTOCOL_HEADER=
HOST_HEADER=host
ADDRESS_HEADER=
XFF_DEPTH=1
