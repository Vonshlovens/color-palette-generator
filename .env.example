# Local development. Docker Compose overrides this default with file:/data/local.db.
TURSO_DATABASE_URL=file:local.db

# Required only for a remote libSQL/Turso URL. An empty value is treated as absent.
TURSO_AUTH_TOKEN=

# Docker Compose host binding and canonical public application URL.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
ORIGIN=http://localhost:3000

# Use forwarded headers only behind a trusted reverse proxy; see README.md.
PROTOCOL_HEADER=
HOST_HEADER=host
ADDRESS_HEADER=
XFF_DEPTH=1

# --- Auth (Better Auth, magic link only, owner-approved) ---
# Required in production: at least 32 random characters, e.g. `openssl rand -base64 32`.
# Development falls back to a fixed insecure secret when unset.
BETTER_AUTH_SECRET=
# Public URL used in sign-in links. Falls back to ORIGIN; required in production.
BETTER_AUTH_URL=
# The owner is always approved and can open /approvals. Defaults to eric@ericevans.dev.
OWNER_EMAIL=eric@ericevans.dev
# Stop accepting new access requests while this many are pending (default 25).
AUTH_MAX_PENDING_REQUESTS=25

# Email delivery through the Resend HTTP API. Without RESEND_API_KEY, development prints
# sign-in links to the server console and production refuses to send.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Palette Studio <login@example.com>"
