          "value": "\"palettes\".\"colors\" is null or (json_valid(\"palettes\".\"colors\") and json_type(\"palettes\".\"colors\") = 'array' and json_array_length(\"palettes\".\"colors\") between 1 and 7)"
        },
        "palettes_freeform_colors_check": {
